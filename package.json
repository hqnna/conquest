{
  "name": "conquest",
  "version": "0.1.0",
  "description": "A Discord bot running a persistent, per-guild strategy game",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "build/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "gts lint",
    "fix": "gts fix",
    "format": "gts fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy-commands": "tsx src/scripts/deploy-commands.ts",
    "generate-countries": "tsx src/scripts/generate-countries.ts",
    "generate-map": "tsx src/scripts/generate-map.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "gts": "^7.0.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
