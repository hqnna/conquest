# Conquest configuration. Copy to .env and fill in, or export these directly.

# Bot token from the Discord developer portal (required).
DISCORD_TOKEN=

# Application (client) ID, used to register slash commands (required).
DISCORD_CLIENT_ID=

# Register commands to a single guild instead of globally. Guild commands
# update instantly, which is what you want while developing.
DISCORD_GUILD_ID=

# Where the game database lives.
CONQUEST_DB_PATH=conquest.db

# Set to 1 to shorten every game timer drastically for manual playtesting.
CONQUEST_DEV_MODE=
